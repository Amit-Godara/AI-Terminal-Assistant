# AI Terminal Assistant Configuration Environment Variables
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# NLP & Model Settings
CONFIDENCE_THRESHOLD=0.65
USE_SEMANTIC_FALLBACK=True
SEMANTIC_SIMILARITY_THRESHOLD=0.70
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Safety & Execution
SAFE_MODE=True
COMMAND_TIMEOUT_SECONDS=15
REQUIRE_CONFIRMATION=True
